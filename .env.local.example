NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional — transactional email (welcome, approvals, entries, results, handicap updates).
# Leave unset and the app just logs what it would have sent instead of erroring.
RESEND_API_KEY=
# Without a verified domain in Resend, leave this as the shared sender below —
# it can only deliver to the email address your Resend account was created with.
# Once you verify a domain, change this to e.g. "TP Tour <noreply@tptour.ae>".
RESEND_FROM_EMAIL=TP Tour <onboarding@resend.dev>
